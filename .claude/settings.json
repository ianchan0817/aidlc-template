{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(bun *)",
      "Bash(node *)",
      "Bash(npm run *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pytest *)",
      "Bash(pip *)",
      "Bash(cargo *)",
      "Bash(go *)",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(psql *)",
      "Bash(redis-cli *)",
      "Bash(curl *)",
      "Bash(jq *)",
      "Bash(cat .claude/*)",
      "Bash(cat aidlc/*)",
      "Bash(ls *)",
      "Bash(find * -name *)",
      "Bash(grep *)",
      "Bash(wc *)",
      "Bash(which *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(git push --force *)",
      "Bash(cat .secrets.gpg)",
      "Bash(gpg --decrypt *)",
      "Bash(git reset --hard *)",
      "Bash(DROP *)",
      "Bash(truncate *)",
      "Read(.env)",
      "Read(.env.production)",
      "Read(.env.local)",
      "Read(**/.env)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '%s\\n' 'AIDLC: Read aidlc/common/session-lifecycle.md (get bearings). Then memory/progress.md, memory/feature-list.json, git log -20; run ./init.sh if present (copy from init.sh.example).'",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'echo \"$CLAUDE_TOOL_INPUT\" | grep -qE \"(rm -rf /|chmod -R 777 /)\" && { echo \"Blocked: dangerous command pattern\" >&2; exit 2; } || exit 0'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
