# CodeQL — copy to codeql.yml once this repo contains application code.
#
# Deliberately shipped inactive (`.yml.example`, which Actions ignores, same
# idiom as init.sh.example): the template itself holds only markdown, config,
# and shell. CodeQL supports none of those, so an active workflow here would
# fail on every run with "no source code found" and train you to ignore a red X.
#
# Setup:
#   1. cp .github/workflows/codeql.yml.example .github/workflows/codeql.yml
#   2. Set `language:` below to your stack.
#   3. Compiled languages (java-kotlin, c-cpp, csharp, swift) usually need a
#      real build — replace the autobuild step with your build command.

name: codeql

on:
  push:
    branches: [main]
  pull_request:
  schedule:
    - cron: "17 3 * * 1"

permissions:
  contents: read

# One analysis per ref. `cancel-in-progress` is deliberately PR-only: cancelling
# a push or scheduled run on the default branch leaves the code-scanning
# baseline stale, and every later PR is then diffed against nothing.
concurrency:
  group: codeql-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

jobs:
  analyze:
    name: analyze (${{ matrix.language }})
    runs-on: ubuntu-latest
    permissions:
      security-events: write
      packages: read
      actions: read
      contents: read
    strategy:
      fail-fast: false
      matrix:
        # Pick what applies. Remove the rest.
        language: [javascript-typescript]
        # language: [python]
        # language: [go]
        # language: [ruby]
        # language: [rust]
        # language: [java-kotlin]   # needs a build
        # language: [c-cpp]         # needs a build
        # language: [csharp]        # needs a build
        # language: [actions]       # scans workflow files themselves
    steps:
      # Every `uses:` is SHA-pinned with the version in a trailing comment: a
      # tag is mutable, so `@v4` asks for whatever that name points at today —
      # and this action runs with `security-events: write`. Dependabot reads
      # the comment and bumps pin and comment together.
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      # All three codeql-action steps ship from one repo, so one SHA serves
      # init/autobuild/analyze. Bump them together — mixed versions are
      # unsupported.
      - uses: github/codeql-action/init@5595ccaf912efad79be6eef63a5619ff05969be3 # v4.37.6
        with:
          languages: ${{ matrix.language }}
          # security-and-quality is the widest query pack: security alerts plus
          # maintainability. Use security-extended for security-only.
          queries: security-and-quality

      - uses: github/codeql-action/autobuild@5595ccaf912efad79be6eef63a5619ff05969be3 # v4.37.6

      - uses: github/codeql-action/analyze@5595ccaf912efad79be6eef63a5619ff05969be3 # v4.37.6
        with:
          category: "/language:${{ matrix.language }}"
